  "steps": {
    "tr": [
      "Domatesleri yıkayıp kurulayın ve yaklaşık 1 cm kalınlığında halkalar halinde dilimleyin.",
      "Taze mozzarellayı süzdürüp domatesle aynı kalınlıkta dilimleyin.",
      "Servis tabağına domates ve mozzarella dilimlerini sırayla, birbirinin üstüne hafifçe binecek şekilde dizin; aralarına fesleğen yapraklarını sıkıştırın.",
      "Üzerine tuz ve taze çekilmiş karabiber serpin, zeytinyağı ve balzamik sirke gezdirip hemen servis edin."
    ],
    "en": [
      "Wash and dry the tomatoes and slice them into rounds about 1 cm thick.",
      "Drain the fresh mozzarella and cut it into slices of the same thickness.",
      "Arrange the tomato and mozzarella slices on a platter, alternating and slightly overlapping, tucking the basil leaves in between.",
      "Season with the salt and freshly ground black pepper, drizzle with the olive oil and balsamic vinegar, and serve at once."
    ]
