// Recipely — Prisma schema
// Keep this aligned with domain entities. Infra maps DB rows -> domain via mappers.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"] // Alpine runtime
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Users ----------

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique @db.Citext
  passwordHash     String?   @map("password_hash")
  displayName      String    @map("display_name")
  bio              String?   @map("bio")
  photoUrl         String?   @map("photo_url")
  role             String    @default("user") @map("role")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  // Account deletion tombstone. A deleted account keeps its row (so its content
  // and audit trail survive) but is scrubbed of PII and its `email` is rewritten
  // to a tombstone address, which frees the real address for a fresh signup —
  // that signup is a brand-new row with a brand-new id, never a resurrection.
  // Every read path must filter on `deletedAt: null`.
  deletedAt        DateTime? @map("deleted_at")
  // Suspension is a separate, reversible state from deletion: a suspended
  // account's row, content, and PII are all untouched, and lifting it is a
  // plain unsuspend. `suspendedAt` non-null is what the active-account check
  // rejects on; `suspensionReason` is admin-facing context, shown on the User
  // show page and captured when the suspend action runs.
  suspendedAt      DateTime? @map("suspended_at")
  suspensionReason String?   @map("suspension_reason")

  recipes               Recipe[]             @relation("RecipeOwner")
  favorites             Favorite[]
  likes                 RecipeLike[]
  commentLikes          CommentLike[]
  aiGenerationLogs      AIGenerationLog[]
  comments              Comment[]            @relation("CommentAuthor")
  fcmTokens             FcmToken[]
  sentNotifications     Notification[]       @relation("NotificationSender")
  receivedNotifications Notification[]       @relation("NotificationRecipient")
  following             UserFollow[]         @relation("UserFollower")
  followers             UserFollow[]         @relation("UserFollowing")
  passwordResetTokens   PasswordResetToken[]
  drafts                RecipeDraft[]
  importJobs            ImportJob[]
  feedbacks             Feedback[]
  assistantUsage        AssistantUsage[]
  devices               Device[]
  foodLogEntries        FoodLogEntry[]
  diaryWater            DiaryDayWater[]
  nutritionGoals        NutritionGoals?
  creatorTags           CreatorTag[]
  instagramConnection   InstagramConnection?
  instagramPendingLinks InstagramPendingLink[]
  dmRules               DmRule[]

  // Superset of a plain deletedAt index (leftmost-prefix rule) — every current
  // deletedAt-only lookup is already narrowed by a unique id/email first, so
  // this single composite also backs the admin dashboard's active-user total
  // and last-7-days signup count, which range on createdAt too.
  @@index([deletedAt, createdAt(sort: Desc)])
  @@map("users")
}

// A user's claim to one social account, approved or rejected by an admin. One
// row per (user, platform), so a user can hold an Instagram and a TikTok tag at
// once, each reviewed on its own. `status` is the CreatorStatus vocabulary.
// One approved holder per (platform, handle) is enforced by a partial unique
// index in the migration (Prisma cannot express the WHERE clause). Account
// deletion removes the rows, freeing the handles.
model CreatorTag {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  platform    String
  handle      String
  status      String
  requestedAt DateTime  @map("requested_at")
  reviewedAt  DateTime? @map("reviewed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  // The admin review queue and the public creators list both filter on it.
  @@index([status])
  @@map("creator_tags")
}

// ---------- Account audit log ----------

enum AccountEventType {
  DELETED
  RECREATED
  SUSPENDED
  UNSUSPENDED
}

/// Immutable audit trail of account lifecycle events.
///
/// Deliberately has NO foreign key to `users`: the log must outlive the row it
/// describes (a future retention job may hard-purge tombstoned users), and a
/// cascade would erase exactly the record we keep this table for.
///
/// `emailHash` is a SHA-256 fingerprint of the normalised address — it links a
/// re-registration to the deletions that preceded it without re-introducing the
/// PII that deletion just scrubbed.
model AccountEventLog {
  id             String           @id @default(uuid()) @db.Uuid
  event          AccountEventType
  /// The account the event is about: the old id for DELETED, the new id for RECREATED.
  userId         String           @map("user_id") @db.Uuid
  emailHash      String           @map("email_hash")
  /// RECREATED only: the tombstoned account whose address this signup reclaimed.
  previousUserId String?          @map("previous_user_id") @db.Uuid
  /// SUSPENDED/UNSUSPENDED only: the admin who performed it. No foreign key,
  /// for the same reason the subject has none — the record must outlive the
  /// people in it. An unattributed moderation action is not an audit trail.
  actorId        String?          @map("actor_id") @db.Uuid
  /// SUSPENDED only: the reason the admin typed. `User.suspensionReason` is
  /// wiped when the ban is lifted, so without this the WHY disappears at
  /// exactly the moment someone would want to look it up.
  reason         String?          @map("reason")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([emailHash, createdAt(sort: Desc)])
  @@index([userId])
  @@map("account_event_logs")
}

// ---------- Recipes ----------

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum RecipeCategory {
  BREAKFAST
  BRUNCH
  LUNCH
  DINNER
  DESSERT
  SNACK
  DRINK
  SMOOTHIE
  SOUP
  STEW
  SALAD
  APPETIZER
  SIDE_DISH
  MAIN_COURSE
  PASTA
  PIZZA
  SANDWICH
  BREAD
  BAKING
  SAUCE
  GRILL
  RICE
  NOODLE
  SEAFOOD
  CASSEROLE
  CURRY
  DUMPLING
  PIE
  WRAP
  CAKE
  COOKIE
  PRESERVE
}

enum CuisineKey {
  TURKISH
  ITALIAN
  MEXICAN
  CHINESE
  JAPANESE
  INDIAN
  FRENCH
  GREEK
  AMERICAN
  MEDITERRANEAN
  THAI
  SPANISH
  KOREAN
  MIDDLE_EASTERN
  GERMAN
  BRITISH
  VIETNAMESE
  LEBANESE
  MOROCCAN
  BRAZILIAN
  RUSSIAN
  PERSIAN
  CARIBBEAN
  FILIPINO
  INDONESIAN
  PAKISTANI
  CAUCASIAN
  AFRICAN
  GEORGIAN
  AZERBAIJANI
  ARMENIAN
  UZBEK
  CENTRAL_ASIAN
  SYRIAN
  EGYPTIAN
  TUNISIAN
  BALKAN
  PORTUGUESE
  POLISH
  SWEDISH
  MALAYSIAN
  PERUVIAN
  ARGENTINIAN
  OTHER
}

/// Where a recipe's text came from: a person typed it, a model wrote it, or it
/// was lifted from a post somewhere else.
/// Which video platform an imported recipe was lifted from.
enum SourcePlatform {
  INSTAGRAM
  TIKTOK
  WEB
  FACEBOOK
  YOUTUBE
}

enum RecipeOrigin {
  USER
  AI
  IMPORT
  /// Published by Recipely itself, under the official account: text written
  /// by us, nutrition from USDA FoodData Central, an openly licensed photo.
  CURATED
}

model Recipe {
  id                 String         @id @default(uuid()) @db.Uuid
  name               Json           @map("name") @db.Json
  cuisine            CuisineKey     @default(OTHER) @map("cuisine")
  category           RecipeCategory @default(MAIN_COURSE) @map("category")
  difficulty         Difficulty     @default(EASY)
  ingredients        Json           @map("ingredients") @db.Json
  instructions       Json           @map("instructions") @db.Json
  prepTimeMinutes    Int            @map("prep_time_minutes")
  cookTimeMinutes    Int            @map("cook_time_minutes")
  servings           Int            @default(1)
  caloriesPerServing Int            @default(0) @map("calories_per_serving")
  nutrition          Json?          @map("nutrition") @db.Json
  tips               Json?          @map("tips") @db.Json
  // Materialized prep+cook total. Maintained by the application layer on
  // create/update so the `?maxTime=` filter can use an index.
  totalTimeMinutes   Int            @default(0) @map("total_time_minutes")
  image              String
  rating             Float          @default(0)
  tags               Json           @map("tags") @db.Json
  mealType           Json           @default("[]") @map("meal_type") @db.Json
  commentCount       Int            @default(0) @map("comment_count")
  viewCount          Int            @default(0) @map("view_count")
  isPublished        Boolean        @default(true) @map("is_published")
  moderationStatus   String         @default("approved") @map("moderation_status")
  // Where the recipe came from: a dataset's canonical URL (food.com, seed:…)
  // or the post / page a user imported. NULL for manually-created recipes.
  // Unique PER OWNER among live rows (see the index note below), not globally: two cooks importing
  // the same reel is the ordinary case, and a global key made the second
  // one's publish fail as "recipe already exists".
  sourceUrl          String?        @map("source_url")
  /// Where the text came from. Derivable before this column existed — an import
  /// left `sourceUrl` set, a generation left an `AIGenerationLog` pointing back
  /// — but answering it for a LIST meant joining a log table per card.
  origin             RecipeOrigin   @default(USER)
  /// The account a video was lifted from, without the '@'. yt-dlp has always
  /// returned it in the probe; nothing read it.
  sourceHandle       String?        @map("source_handle")
  /// Which platform an import came from. NULL when nothing was imported.
  ///
  /// Separate from `origin` because they answer different questions and a
  /// single enum could only answer one at a time: an Instagram import IS
  /// AI-written, since the model is what turns a video into a recipe.
  sourcePlatform     SourcePlatform? @map("source_platform")
  /// Whether a model produced the text. True for a generation and for every
  /// import; false for a recipe someone typed out.
  aiWritten          Boolean        @default(false) @map("ai_written")
  /// What a web import arrived as, for the copyright gate on publishing: the
  /// stored copy of the site's photo, and sha256 digests of the normalised
  /// ingredient and step lists. Written once, from the draft, and never again.
  /// NULL on everything else — including every row from before the gate —
  /// which means "nothing to compare against", so no gate.
  importedImage      String?        @map("imported_image")
  /// Where the dish sits in the cover photo, 0..1 from the left and the top,
  /// so a cropped frame centres on the food rather than on hands or a pot.
  /// NULL until the photo-focus sweep has looked at it — NULL reads as
  /// "centred", which is what every client did before the column existed.
  imageFocusX        Float?         @map("image_focus_x")
  imageFocusY        Float?         @map("image_focus_y")
  /// How many sweeps failed to find the focus of this cover. The sweep stops
  /// picking a cover once this reaches its cap, so an unreadable photo is not
  /// an AI call every ten minutes forever. Reset whenever the cover changes.
  imageFocusAttempts Int            @default(0) @map("image_focus_attempts")
  importedIngredientsHash String?   @map("imported_ingredients_hash")
  importedInstructionsHash String?  @map("imported_instructions_hash")
  /// The cover photo's credit — author, licence (the ImageLicense vocabulary)
  /// and the source page. Set only on CURATED recipes; NULL everywhere else.
  imageCreditAuthor  String?        @map("image_credit_author")
  imageCreditLicense String?        @map("image_credit_license")
  imageCreditUrl     String?        @map("image_credit_url")
  /// Where the nutrition figures came from (the NutritionSource vocabulary).
  /// NULL means estimated, which is every recipe but the curated ones.
  nutritionSource    String?        @map("nutrition_source")
  /// sha256 of the curated import's SOURCE photo file, so a re-import that
  /// did not change the photo does not upload (and orphan) a second copy.
  imageSourceHash    String?        @map("image_source_hash")
  /// The curated import's key: unique per owner where set (a partial index in
  /// 20260930210000_curated_recipes, which Prisma cannot declare).
  slug               String?        @map("slug")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  deletedAt          DateTime?      @map("deleted_at")

  ownerId String @map("owner_id") @db.Uuid
  owner   User   @relation("RecipeOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  favorites        Favorite[]
  dmRules          DmRule[]
  likes            RecipeLike[]
  media            RecipeMedia[]
  aiGenerationLogs AIGenerationLog[]
  comments         Comment[]
  notifications    Notification[]
  foodLogEntries   FoodLogEntry[]

  // Query shape: list + search + pagination on createdAt
  @@index([origin])
  @@index([isPublished, createdAt(sort: Desc)])
  @@index([totalTimeMinutes])
  @@index([isPublished, rating(sort: Desc)])
  @@index([isPublished, viewCount(sort: Desc)])
  @@index([ownerId, moderationStatus])
  @@index([category])
  @@index([cuisine])
  @@index([commentCount(sort: Desc)])
  // Backs the admin panel's moderationStatus filter (moderation queue lookups
  // that aren't already scoped by ownerId).
  @@index([moderationStatus])
  // (ownerId, sourceUrl) is unique among LIVE rows only — a partial index in
  // 20260928120000_source_url_unique_live_only, which Prisma cannot declare.
  // A soft-deleted recipe must not stop its owner saving the same link again.
  @@map("recipes")
}

// Photos and videos attached to a recipe. Frontend renders the gallery on the
// detail screen. `type` is "image" or "video" — kept as a plain string instead
// of an enum so we can add types (e.g. audio) without a schema change.
model RecipeMedia {
  id        String   @id @default(uuid()) @db.Uuid
  recipeId  String   @map("recipe_id") @db.Uuid
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  type      String
  url       String
  position  Int      @default(0)
  /// The dish's centre in this photo, 0..1; NULL until the sweep finds it.
  focusX    Float?   @map("focus_x")
  focusY    Float?   @map("focus_y")
  /// Failed focus detections; the sweep gives up at its cap. See Recipe.imageFocusAttempts.
  focusAttempts Int  @default(0) @map("focus_attempts")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([recipeId, position])
  @@map("recipe_media")
}

// ---------- Favorites ----------

model Favorite {
  // Surrogate single-column PK so the table is a first-class AdminJS resource
  // (AdminJS/@adminjs/prisma requires a single `id`). The (userId, recipeId)
  // pair stays unique, so the named composite selector is unchanged for queries.
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  recipeId  String   @map("recipe_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId, createdAt(sort: Desc)])
  // Reverse lookup ("who favorited this recipe"): recipeId is the trailing
  // member of the unique above, so Postgres cannot use it as a leading column.
  // RecipeLike/CommentLike already carry the equivalent index.
  @@index([recipeId])
  @@map("favorites")
}

// ---------- Likes ----------

model RecipeLike {
  // Surrogate single-column PK for AdminJS; see Favorite for rationale.
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  recipeId  String   @map("recipe_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([recipeId])
  // Serves "the recipes I liked, newest first" — the same access path Favorite
  // has. The unique pair indexes (userId, recipeId), which cannot order by
  // createdAt, so without this the liked list sorts in memory over every like
  // the user has ever left.
  @@index([userId, createdAt(sort: Desc)])
  @@map("recipe_likes")
}

// ---------- AI Generation Logs ----------

// Audit trail for AI-generated recipes. `generatedRecipeId` is nullable so we
// can record failed attempts (parse errors, upstream API failures) too.
model AIGenerationLog {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  userPrompt        String   @map("user_prompt")
  generatedRecipeId String?  @map("generated_recipe_id") @db.Uuid
  provider          String
  modelUsed         String   @map("model_used")
  status            String
  errorMessage      String?  @map("error_message")
  createdAt         DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe? @relation(fields: [generatedRecipeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("ai_generation_logs")
}

// ---------- Assistant ----------

// One row per user per day of voice-assistant use. The daily allowance is
// enforced here rather than on the device because the token the device holds
// is a bearer credential: whatever the app believes about the budget, only the
// server's count decides whether another session is minted.
//
// `seconds` is charged by heartbeat, so a client that stops reporting stops
// spending — and a client killed mid-session has already paid for what it used.
// `sessions` is counted too, because a burst of very short sessions costs setup
// tokens that the seconds alone do not show.
model AssistantUsage {
  // Surrogate single-column PK for AdminJS; see Favorite for rationale.
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  day      DateTime @map("day") @db.Date
  seconds  Int      @default(0) @map("seconds")
  sessions Int      @default(0) @map("sessions")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day])
  @@map("assistant_usage")
}

// ---------- Feature Flags ----------

model FeatureFlag {
  key     String  @id
  enabled Boolean @default(true)

  @@map("feature_flags")
}

// ---------- Comments ----------

model Comment {
  id               String    @id @default(uuid()) @db.Uuid
  body             String
  rating           Int?      @map("rating")
  moderationStatus String    @default("approved") @map("moderation_status")
  recipeId         String    @map("recipe_id") @db.Uuid
  authorId         String    @map("author_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  recipe        Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  author        User           @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  likes         CommentLike[]
  notifications Notification[]

  @@index([recipeId, createdAt(sort: Desc)])
  @@index([authorId])
  // Backs the admin panel's moderationStatus filter (moderation queue lookups).
  @@index([moderationStatus])
  @@map("comments")
}

model CommentLike {
  // Surrogate single-column PK for AdminJS; see Favorite for rationale.
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  commentId String   @map("comment_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("comment_likes")
}

// ---------- User Follows ----------

model UserFollow {
  // Surrogate single-column PK for AdminJS; see Favorite for rationale.
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("UserFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("user_follows")
}

// ---------- Password Reset Tokens ----------

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------- Pending Registrations ----------

// Holds an in-flight signup until the emailed 6-digit code is verified. The
// real User is created only on verify, then the row is deleted. Keyed by email
// (unique) so a re-request replaces any prior pending row for that address.
model PendingRegistration {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique @db.Citext
  passwordHash   String   @map("password_hash")
  displayName    String   @map("display_name")
  codeHash       String   @map("code_hash")
  expiresAt      DateTime @map("expires_at")
  attempts       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  lastCodeSentAt DateTime @default(now()) @map("last_code_sent_at")

  @@index([expiresAt])
  @@map("pending_registrations")
}

// ---------- FCM Tokens ----------

model FcmToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  String // "ios" | "android" | "web"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("fcm_tokens")
}

// A passive login-device record. One row per (user, deviceId): a shared
// device produces one row per user who has logged into it, so a login from
// user B upserts *B's* row and never touches user A's history on the same
// physical device. `@@unique([userId, deviceId])` on purpose, not a global
// unique on `deviceId` — see FcmToken above for the contrasting case, where a
// token IS the delivery address and must be globally unique for push to land
// on exactly one owner. This model is an audit trail, not a delivery channel.
model Device {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  deviceId    String   @map("device_id")
  platform    String // "ios" | "android" | "web"
  appVersion  String?  @map("app_version")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  lastLoginAt DateTime @default(now()) @map("last_login_at")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([deviceId])
  @@index([userId, lastLoginAt(sort: Desc)])
  @@map("devices")
}

// ---------- Recipe Drafts ----------

// Work-in-progress recipe drafts. One draft per in-progress session; the client
// upserts by id. Snapshot and chatHistory are intentionally flexible JSON —
// drafts are incomplete by design (hence no validation for completeness at the
// domain level). Cascade-deleted when the owning user is deleted.
model RecipeDraft {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @map("owner_id") @db.Uuid
  prompt      String
  snapshot    Json     @map("snapshot") @db.Json
  chatHistory Json     @map("chat_history") @db.Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, updatedAt(sort: Desc)])
  @@map("recipe_drafts")
}

// ---------- Background work ----------

/// A unit of work a worker picks up, runs, and reports back on.
///
/// Why a table and not a queue service: the only queue in play here is a
/// handful of imports at a time, and a row lets the job live in the same
/// transaction as the draft it produces. `SELECT ... FOR UPDATE SKIP LOCKED`
/// is what makes two workers safe to run against it — each claims a different
/// row instead of both taking the same one.
///
/// Why the work moved off the API box at all: an Instagram import runs yt-dlp,
/// a transcription and a vision pass, measured at ~119 s on a 1 OCPU host. It
/// was holding an HTTP request open the whole time, which is both a bad
/// experience and a request nothing else could be doing.
model ImportJob {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  /// The link to import. Kept so a retry needs nothing else.
  url       String
  /// What kind of link it is. A WEB job is handed only to a worker that says
  /// it can read one; NULL (every row queued before this) is an Instagram video.
  sourcePlatform SourcePlatform? @map("source_platform")
  /// The language the recipe should be extracted in, and the completion push
  /// written in. Carried on the job because the worker never sees the request:
  /// it runs minutes later on another machine, and a URL says nothing about
  /// who asked or in what language.
  locale    String    @default("en")
  /// queued | running | done | failed
  status    String    @default("queued")
  /// Which worker holds it, for diagnosing a job that stopped moving.
  claimedBy String?   @map("claimed_by")
  /// When the claim was taken. A claim older than the lease is reclaimable —
  /// that is what stops a worker dying mid-job from stranding the row forever.
  claimedAt DateTime? @map("claimed_at")
  /// Claims so far. Bounded so a job that kills every worker it touches stops
  /// being handed out rather than taking the fleet down one at a time.
  attempts  Int       @default(0)
  /// The draft produced on success; the thing the completion notification opens.
  draftId   String?   @map("draft_id") @db.Uuid
  /// Machine key for the failure, resolved to copy by the client. Never a
  /// sentence — the client picks the wording, in the user's language.
  errorKey  String?   @map("error_key")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// The claim query orders by this and filters on status; without the index it
  /// is a sequential scan on every poll from every worker.
  @@index([status, createdAt])
  @@index([ownerId, createdAt(sort: Desc)])
  @@map("import_jobs")
}

// ---------- Feedback ----------

model Feedback {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  category     String   @map("category")
  subject      String?  @map("subject")
  message      String   @map("message")
  rating       Int?     @map("rating")
  contactEmail String?  @map("contact_email")
  status       String   @default("new") @map("status")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("feedbacks")
}

// ---------- Notifications ----------

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  type        String // "comment" | "like" | "follow" | "ai_completed" | "moderation" | "import_done" | "creator_approved" | "creator_rejected"
  senderId    String?   @map("sender_id") @db.Uuid
  recipeId    String?   @map("recipe_id") @db.Uuid
  // The comment this notification points at, so the app can deep-link straight
  // to it. Only set for "comment" notifications; null for every other type.
  // SetNull on delete: a deleted comment leaves the notification pointing at
  // the recipe rather than at a row that no longer exists.
  commentId   String?   @map("comment_id") @db.Uuid
  // The draft an "import_done" notification opens. Null for every other type.
  // No FK: a draft the user deletes should leave the notification readable
  // rather than cascade it away, and the client already handles a draft that
  // is gone by the time the notification is tapped.
  draftId     String?   @map("draft_id") @db.Uuid
  // Free-text content carried by the notification (e.g. the comment body).
  // Null for types that have no textual payload, like likes and follows.
  message     String?
  // Where an "import_done" row's recipe came from ("INSTAGRAM" | "TIKTOK" |
  // "FACEBOOK" | "YOUTUBE" | "WEB") and the account or site, so the in-app row
  // can say what the push said. Null for every other type and for import rows
  // written before these columns existed.
  sourcePlatform String? @map("source_platform")
  sourceHandle   String? @map("source_handle")
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  // Set when the notification's source comment is soft-deleted, so it can be
  // hidden from the feed without losing the row (matches Comment's own
  // soft-delete pattern).
  deletedAt   DateTime? @map("deleted_at")
  recipient   User      @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender      User?     @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  recipe      Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  comment     Comment?  @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([recipientId, read, createdAt(sort: Desc)])
  @@index([commentId])
  @@map("notifications")
}

// ─── Food diary ───────────────────────────────────────────────────────────────
// A per-user calorie and nutrient log. `date` is the CLIENT's local calendar day
// as a DATE, never a timestamp: a meal eaten at 23:30 in Istanbul belongs to that
// day, and a timestamp would move it to the next one for any server in UTC.

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model FoodLogEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @db.Date
  meal      MealSlot
  name      String   @db.VarChar(120)
  servings  Float
  // Totals for the whole entry, already multiplied by `servings` — the client's
  // snapshot at log time, never recomputed from a recipe that may since change.
  // Macros are nullable: a recipe can carry calories and no macro breakdown,
  // and NULL means "unknown", which totals skip rather than count as zero.
  calories  Int
  protein   Float?
  carbs     Float?
  fat       Float?
  fiber     Float?
  recipeId  String?  @map("recipe_id") @db.Uuid
  // A logged product (the FoodSource vocabulary): a curated catalogue variant
  // or an Open Food Facts barcode, and the unit it was counted in — `servings`
  // is then the quantity of `unitKey` ('g', 'ml' or a ServingUnitKey), and
  // `unitAmount` the base g/ml in one unit. All null for a recipe or quick-add
  // entry. SetNull: a variant removed from the catalogue leaves the snapshot.
  productSource String?      @map("product_source")
  foodVariantId String?      @map("food_variant_id") @db.Uuid
  offBarcode    String?      @map("off_barcode") @db.VarChar(32)
  unitKey       String?      @map("unit_key") @db.VarChar(16)
  unitAmount    Float?       @map("unit_amount")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe      Recipe?      @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  foodVariant FoodVariant? @relation(fields: [foodVariantId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@map("food_log_entries")
}

// ---------- Food catalogue ----------

// A shelf of the catalogue ("dairy", "drinks"), named per locale for the
// Products tab. Written by the catalogue data migrations like the foods.
model FoodCategory {
  key   String @id
  names Json
  rank  Int    @default(0)

  foods Food[]

  @@map("food_categories")
}

// A generic food or drink the diary can log without a recipe ("Ayran",
// "White bread"). Curated by us from typical-composition values; the rows are
// written by data migrations generated from prisma/food-catalog/ and keyed by
// `slug`, so a regenerated catalogue updates in place.
model Food {
  id          String @id @default(uuid()) @db.Uuid
  slug        String @unique
  category    String
  // Display name per locale: {"en":"Ayran","tr":"Ayran",...}.
  names       Json
  // 'g' or 'ml' — what the per-100 values of its variants are per.
  defaultUnit String @map("default_unit")
  // Catalogue order (most common first); breaks search ties.
  rank        Int    @default(0)

  variants     FoodVariant[]
  foodCategory FoodCategory  @relation(fields: [category], references: [key])

  @@index([category])
  @@map("foods")
}

// One composition of a food ("Low-fat", "Zero sugar"). Nutrition is per 100 g
// or ml of the food's default unit; macros are null when unknown.
model FoodVariant {
  id           String  @id @default(uuid()) @db.Uuid
  foodId       String  @map("food_id") @db.Uuid
  // Stable within the food ("regular", "low_fat"); the upsert key.
  key          String
  names        Json
  position     Int     @default(0)
  kcal         Float
  protein      Float?
  carbs        Float?
  fat          Float?
  fiber        Float?
  sugar        Float?
  salt         Float?
  // [{"key":"glass","amount":200}, ...] — ServingUnitKey portions, amount in the
  // food's base unit, offered besides g/ml.
  servingUnits Json    @map("serving_units")
  // The FoodSource vocabulary; always 'curated' for catalogue rows.
  source       String  @default("curated")

  food           Food           @relation(fields: [foodId], references: [id], onDelete: Cascade)
  foodLogEntries FoodLogEntry[]

  @@unique([foodId, key])
  @@map("food_variants")
}

model DiaryDayWater {
  id      String   @id @default(uuid()) @db.Uuid
  userId  String   @map("user_id") @db.Uuid
  date    DateTime @db.Date
  glasses Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("diary_day_water")
}

model NutritionGoals {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  calories     Int      @default(2000)
  protein      Float    @default(120)
  carbs        Float    @default(230)
  fat          Float    @default(65)
  fiber        Float    @default(30)
  waterGlasses Int      @default(8) @map("water_glasses")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("nutrition_goals")
}

// ---------- Instagram automations ----------

// A creator's Instagram professional account, linked through Business Login
// for Instagram. One per user and one per Instagram account. The access token
// is long-lived (~60 days), refreshed by the token job, and stored ENCRYPTED
// (AES-256-GCM, key derived from JWT_SECRET) — never sent to a client.
// `status` is the InstagramConnectionStatus vocabulary.
model InstagramConnection {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  // The professional account id webhooks name (`entry.id`) and messages are sent as.
  igUserId       String   @unique @map("ig_user_id")
  // The app-scoped id `/me` answers (`id`); Meta's deauthorize and
  // data-deletion callbacks may name the account by either.
  appScopedId    String?  @map("app_scoped_id")
  username       String
  accessTokenEnc String   @map("access_token_enc")
  tokenExpiresAt DateTime @map("token_expires_at")
  status         String
  connectedAt    DateTime @default(now()) @map("connected_at")
  refreshedAt    DateTime @default(now()) @map("refreshed_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, tokenExpiresAt])
  @@index([appScopedId])
  @@map("instagram_connections")
}

// An Instagram authorization waiting for the app to claim it. The OAuth
// callback lands in a browser with no session, so it parks the account and
// token here and hands the app a one-time code; only an authenticated
// finalise call by the SAME user who started the connect turns it into a
// connection. Short-lived; the code is stored hashed, the token encrypted.
model InstagramPendingLink {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  codeHash       String   @unique @map("code_hash")
  igUserId       String   @map("ig_user_id")
  appScopedId    String?  @map("app_scoped_id")
  username       String
  accessTokenEnc String   @map("access_token_enc")
  tokenExpiresAt DateTime @map("token_expires_at")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("instagram_pending_links")
}

// "When someone comments one of these keywords on this post, send them this
// recipe." Keywords are stored as typed; matching folds case and diacritics.
model DmRule {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  mediaId         String   @map("media_id")
  // Snapshot of the post for the list, taken when the rule was saved.
  mediaPermalink  String?  @map("media_permalink")
  mediaThumbnail  String?  @map("media_thumbnail")
  mediaCaption    String?  @map("media_caption")
  keywords        String[]
  recipeId        String   @map("recipe_id") @db.Uuid
  dmText          String   @map("dm_text")
  publicReplyText String?  @map("public_reply_text")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  sends  DmSend[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([mediaId, enabled])
  @@map("dm_rules")
}

// One private reply attempt. `commentId` is unique: Instagram allows one
// private reply per comment, and a redelivered webhook must not send twice.
// `status` is the DmSendStatus vocabulary.
model DmSend {
  id                String    @id @default(uuid()) @db.Uuid
  ruleId            String    @map("rule_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  commentId         String    @unique @map("comment_id")
  commenterId       String?   @map("commenter_id")
  commenterUsername String?   @map("commenter_username")
  commentText       String?   @map("comment_text")
  status            String
  reason            String?
  publicReplied     Boolean   @default(false) @map("public_replied")
  createdAt         DateTime  @default(now()) @map("created_at")
  sentAt            DateTime? @map("sent_at")

  rule DmRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("dm_sends")
}

// Webhook changes waiting to be processed: the webhook answers 200 at once
// and the in-process worker claims rows in order. `status` is the
// InstagramEventStatus vocabulary; `availableAt` delays a retry (rate limits).
model InstagramEvent {
  id          String    @id @default(uuid()) @db.Uuid
  igUserId    String    @map("ig_user_id")
  field       String
  payload     Json
  eventTime   DateTime  @map("event_time")
  status      String
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  @@index([status, availableAt])
  @@index([igUserId])
  @@map("instagram_events")
}

// How far the comment poller has read each post's comments. Webhooks for
// comments reach only Live apps with Advanced Access, so until then (and as a
// safety net after) the poller reads the posts that have enabled rules and
// queues new comments like a webhook would; the one-send-per-comment rule on
// dm_sends keeps the two from ever DMing twice.
model InstagramCommentCursor {
  mediaId    String   @id @map("media_id")
  igUserId   String   @map("ig_user_id")
  // The newest comment time already queued; the next poll reads from here.
  lastSeenAt DateTime @map("last_seen_at")
  polledAt   DateTime @map("polled_at")

  @@index([polledAt])
  @@map("instagram_comment_cursors")
}
