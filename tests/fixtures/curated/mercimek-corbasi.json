  "steps": {
    "tr": [
      "Kırmızı mercimeği yıkayıp süzün.",
      "Soğanı ve havucu küçük doğrayın; tencerede tereyağında 5 dakika kavurun.",
      "Domates salçasını ekleyip 1 dakika çevirin.",
      "Mercimeği ve 1,5 litre suyu ekleyin; kapağı aralık, kısık ateşte 25 dakika pişirin.",
      "Kimyon ve tuzu ekleyin, blenderdan geçirip sıcak servis edin."
    ],
    "en": [
      "Rinse the red lentils and drain them.",
      "Dice the onion and the carrot; soften them in the butter in a pot for 5 minutes.",
      "Stir in the tomato paste for 1 minute.",
      "Add the lentils and 1.5 litres of water; simmer, lid ajar, for 25 minutes.",
      "Season with cumin and salt, blend until smooth and serve hot."
    ]
