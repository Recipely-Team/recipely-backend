  "steps": {
    "tr": [
      "Sivri biberi ince doğrayın, domatesleri rendeleyin.",
      "Tavada zeytinyağını ısıtın, biberleri 3 dakika kavurun.",
      "Domatesi ekleyip suyunu çekene kadar 8 dakika pişirin.",
      "Yumurtaları kırın, tuz ve karabiber serpin; hafifçe karıştırarak 3 dakika pişirin.",
      "Sıcak servis edin."
    ],
    "en": [
      "Finely chop the green pepper and grate the tomatoes.",
      "Warm the olive oil in a pan and soften the pepper for 3 minutes.",
      "Add the tomatoes and cook for 8 minutes until the juice has reduced.",
      "Crack in the eggs, season with salt and black pepper, and stir gently for 3 minutes.",
      "Serve hot."
    ]
