NODE_ENV=production
PORT=3000

# Postgres (docker network hostname = service name)
POSTGRES_USER=recipely
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=recipely
DATABASE_URL=postgresql://recipely:change_me_in_prod@postgres:5432/recipely?schema=public&connection_limit=5

# Auth
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_EXPIRES_IN=7d
# Lifetime of the narrow token the OS assistant (Siri / Android shortcuts) carries,
# in seconds. Optional; defaults to 30 days. Long on purpose — the scope is what
# keeps it safe, not the expiry.
ASSISTANT_INTENT_TOKEN_TTL_SEC=2592000
BCRYPT_ROUNDS=10

# AES-256-GCM key for /api/v1 request/response envelope. Generate with:
#   openssl rand -hex 32
# The mobile client must ship the SAME 64-hex value (EXPO_PUBLIC_API_AES_KEY).
# Caveat: anyone with the mobile binary can extract the key — TLS is the
# proper transport-layer fix; this envelope is a soft wrapper.
API_AES_KEY=replace-with-openssl-rand-hex-32

# Admin panel (AdminJS at /admin)
# When set, the seed creates an admin user on first boot. Leave blank to skip.
# Password must be at least 12 chars. After bootstrap, manage admins via /admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where the panel is served. Default '/admin' serves it under a path on a shared
# host. To serve it at a dedicated host root with no redundant path, set both:
#   ADMIN_ROOT_PATH=/          — AdminJS uses this prefix for every URL it emits
#   ADMIN_HOST=admin.example.com — dispatch the panel ONLY for this hostname so
#                                  the API on other hostnames is unaffected.
# Leave both blank on a single-host deploy where API and panel share one name.
ADMIN_ROOT_PATH=/admin
ADMIN_HOST=

# AdminJS session cookie Secure flag. Keep false while serving plain HTTP —
# browsers reject Secure cookies over HTTP, which silently breaks login.
# Flip to true once HTTPS terminates in front of the API.
COOKIE_SECURE=false

# AI recipe generation. Swap provider/model at runtime — the use case is
# provider-agnostic and the bootstrap reads these env vars to pick the adapter.
# Supported providers:
#   'groq'      — generous free tier, no card required (default)
#   'gemini'    — free tier via AI Studio, but unavailable in some regions
#   'anthropic' — paid, no free tier
# NOTE: this no longer selects the RECIPE GENERATOR. /generate asks every
# provider it has a key for, in order — Gemini, then Groq — so a spent quota is
# a slower answer instead of an outage. AI_PROVIDER still picks the refiner and
# the moderators, which are single-provider.
AI_PROVIDER=groq
# Model id for the refiner and the Anthropic generator. Optional — leave blank
# to fall back to GROQ_MODEL_NAME (correct for the default 'groq' provider).
# Set this only when AI_PROVIDER is 'gemini' or 'anthropic':
#   gemini:    'gemini-flash-latest', 'gemini-2.5-pro'
#   anthropic: 'claude-haiku-4-5', 'claude-sonnet-4-6', 'claude-opus-4-7'
AI_MODEL=
# Model used for ALL Groq calls (recipe gen/refine, nutrition, moderation).
# Must support JSON mode. Defaults to the value below if unset.
# Note: 'llama-4-scout' was shut down by Groq on 2026-07-17 and
# 'llama-3.3-70b-versatile' is deprecated — do not set either.
GROQ_MODEL_NAME=openai/gpt-oss-120b
# Model used for Gemini recipe generation. Blank uses the default below.
# '-latest' on purpose: a pinned version can stop being served without warning.
GEMINI_MODEL_NAME=gemini-flash-latest
# Get from https://console.groq.com/keys. GROQ_API_KEYS (plural, comma-
# separated) is read as well and merged — each key is its own quota.
GROQ_API_KEY=
# Get from https://aistudio.google.com/apikey. GEMINI_API_KEYS (plural) and
# GEMINI_API_KEYS_FREE are read as well and merged into the same pool.
GEMINI_API_KEY=
# Only used by the refiner/moderators when AI_PROVIDER=anthropic. NOT part of
# the /generate chain: the Anthropic adapter is still a placeholder.
ANTHROPIC_API_KEY=

# Firebase project ID for social sign-in (Google / Apple via Firebase Auth).
# Find it in: Firebase console → Project settings → General → Project ID.
FIREBASE_PROJECT_ID=

# Firebase Admin SDK service account JSON (base64-encoded) — required for push notifications.
# Generate from: Firebase console → Project settings → Service accounts → Generate new private key
# Encode with: base64 -i serviceAccount.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# SMTP for transactional emails (registration verification codes + password reset).
# All optional — if any are unset the server falls back to a no-op sender: emails
# are not actually delivered, and in non-production the 6-digit code is returned in
# the API response as `devCode` (and logged) so you can still complete the flow.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# From address shown on outgoing mail, e.g. "Recipely <no-reply@recipely.app>".
SMTP_FROM=
# Universal-link base used to build password-reset deep links
# (<APP_BASE_URL>/reset-password?token=...) that the mobile app intercepts.
# Must match the associated-domain registered in the iOS/Android app.
APP_BASE_URL=https://recipely.net

# Pins the e-mail verification code to a fixed 6-digit value so dev can be
# registered against without a working inbox. NOT gated on NODE_ENV — the dev
# host runs NODE_ENV=production too. It only takes effect when BASE_URL (and
# APP_BASE_URL, if set) is a known non-production host: localhost, 127.0.0.1,
# dev-api.recipely.net or dev.recipely.net. Anything else, including an unset
# or unrecognised BASE_URL, refuses it. Leave empty outside dev.
DEV_FIXED_REGISTRATION_CODE=

# How many proxies sit in front of this instance. SECURITY BOUNDARY, not tuning.
#   1 = nginx only          → hostname is NOT proxied by Cloudflare  (api.recipely.net)
#   2 = Cloudflare + nginx  → hostname IS proxied                    (dev-api.recipely.net)
# At depth 1 a caller can send CF-Connecting-IP themselves, so it is ignored and
# rate limits key on the address nginx recorded. Setting this too HIGH lets a
# caller choose their own rate-limit key. Default 1 — the safe direction.
PROXY_DEPTH=1

# ---- Voice assistant (Gemini Live) ----
# The model id ships from here, not from the app: a model listed by ListModels
# is not necessarily callable, and swapping one is a deploy rather than an App
# Review cycle. The 2.5 native-audio family leaks its reasoning as visible text
# parts and bills ~100 extra tokens a turn, which is why this is the default.
ASSISTANT_LIVE_MODEL=models/gemini-3.1-flash-live-preview
# The typed mode's model — a different family from the Live one, which only
# speaks. This is the fallback the app offers when voice is unavailable, so the
# cheapest text model that can call a tool is the right choice.
ASSISTANT_TEXT_MODEL=gemini-flash-latest
# Seconds of voice per user per day. One complete "make me a recipe" exchange
# measured at ~950 tokens, so ten minutes is generous rather than tight.
ASSISTANT_DAILY_SECONDS=600
# Seconds across every user per day. The free tier is one key for the whole app,
# so past this everyone falls back to the text mode instead of failing.
ASSISTANT_GLOBAL_DAILY_SECONDS=36000

# The assistant's key tiers. Kept apart because a paid key spends money on every
# call and must never absorb free traffic. A user is served by exactly ONE key,
# chosen by a stable hash of their id, so 48 users over 48 keys is one each and
# 96 is two each — and one heavy user cannot bench the whole pool.
# The legacy GEMINI_API_KEY / GEMINI_API_KEYS above fold into FREE.
GEMINI_API_KEYS_FREE=
GEMINI_API_KEYS_PAID=

# Curated import (`npm run curated:import`) only — the API never reads these.
# The official "Recipely Mutfağı" account is found / created by this email.
# CURATED_OWNER_EMAIL=mutfak@recipely.net
# CURATED_UPLOADS_DIR=./public/uploads
